{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",
      "WebFetch",
      "Skill",
      "mcp__*"
    ],
    "deny": [
      "Edit(**/schemas/*)",
      "Write(**/schemas/*)",
      "Edit(**/fault-taxonomy.yaml)",
      "Write(**/fault-taxonomy.yaml)",
      "Edit(**/judge-rubric.yaml)",
      "Write(**/judge-rubric.yaml)",
      "Edit(**/delivery-attestation.schema.json)",
      "Write(**/delivery-attestation.schema.json)",
      "Edit(**/plugin/scripts/pre-delivery-discipline.js)",
      "Write(**/plugin/scripts/pre-delivery-discipline.js)",
      "Edit(**/plugin/scripts/pre-tool-use.js)",
      "Write(**/plugin/scripts/pre-tool-use.js)",
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Write(**/.claude/settings.local.json)",
      "Edit(**/hooks/hooks.json)",
      "Write(**/hooks/hooks.json)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Edit(**/.github/workflows/ci.yml)",
      "Write(**/.github/workflows/ci.yml)",
      "Edit(**/__test_e2e.mjs)",
      "Write(**/__test_e2e.mjs)",
      "Edit(**/tests/governance-events.test.mjs)",
      "Write(**/tests/governance-events.test.mjs)",
      "Edit(**/tests/governance-hooks.test.mjs)",
      "Write(**/tests/governance-hooks.test.mjs)",
      "Edit(**/tests/delivery-discipline-skill.test.mjs)",
      "Write(**/tests/delivery-discipline-skill.test.mjs)",
      "Edit(**/tests/validate-delivery-honesty.test.mjs)",
      "Write(**/tests/validate-delivery-honesty.test.mjs)",
      "Edit(**/tests/delivery-discipline-hook.test.mjs)",
      "Write(**/tests/delivery-discipline-hook.test.mjs)",
      "Edit(**/plugin/scripts/handshake-inject.js)",
      "Write(**/plugin/scripts/handshake-inject.js)",
      "Edit(**/plugin/scripts/objective-loader.js)",
      "Write(**/plugin/scripts/objective-loader.js)",
      "Edit(**/plugin/scripts/loop-wake.js)",
      "Write(**/plugin/scripts/loop-wake.js)",
      "Edit(**/plugin/scripts/r2-bridge-writer.js)",
      "Write(**/plugin/scripts/r2-bridge-writer.js)",
      "Edit(**/vibe-research-environment/environment/orchestrator/autonomy-runtime.js)",
      "Write(**/vibe-research-environment/environment/orchestrator/autonomy-runtime.js)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/session-start.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/prompt-submit.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/post-tool-use.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/stop.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/pre-compact.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/pre-tool-use.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/pre-delivery-discipline.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugin/scripts/subagent-stop.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "MCP_TIMEOUT": "30000",
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "BASH_MAX_TIMEOUT_MS": "600000"
  }
}
